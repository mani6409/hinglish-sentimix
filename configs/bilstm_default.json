{
  "mode": "normalized",
  "use_word": true,
  "use_char": true,
  "word_dim": 100,
  "char_dim": 32,
  "char_filters": 32,
  "char_kernels": [2, 3, 4],
  "hidden_size": 128,
  "num_layers": 1,
  "dropout": 0.4,
  "pooling": "maxmean",
  "word_min_freq": 2,
  "char_min_freq": 2,
  "lowercase_words": true,
  "lowercase_chars": false,
  "max_words": null,
  "max_chars": null,
  "chars_percentile": 99.9,
  "batch_size": 64,
  "epochs": 20,
  "lr": 0.001,
  "weight_decay": 1e-05,
  "grad_clip": 5.0,
  "patience": 4,
  "device": "auto"
}
