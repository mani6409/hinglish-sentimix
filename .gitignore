# Only the Hinglish SemEval-2020 Task 9 files (CC-BY 4.0, about 9 MB) are committed, as the course requires.
# Everything else under data/ (zip copy, Spanglish, processed files) stays out of Git.
data/raw/*
!data/raw/.gitkeep
!data/raw/zenodo_download/
data/raw/zenodo_download/*
!data/raw/zenodo_download/extracted/
data/raw/zenodo_download/extracted/*
!data/raw/zenodo_download/extracted/Semeval_2020_task9_data/
data/raw/zenodo_download/extracted/Semeval_2020_task9_data/*
!data/raw/zenodo_download/extracted/Semeval_2020_task9_data/README.txt
!data/raw/zenodo_download/extracted/Semeval_2020_task9_data/Hinglish/
data/processed/*
!data/processed/.gitkeep
checkpoints/
*.pt
*.pth
*.bin
*.safetensors

# python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# misc
.DS_Store
wandb/
.env
